---
import { u } from '../data/content';
---
<section class="cta photo-cta">
  <div class="hero-photo" style={`background-image:url(${u('/img/hero-austin.jpg')})`} aria-hidden="true"></div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap reveal">
    <div class="eyebrow" style="justify-content:center">Let's build your U.S. pathway</div>
    <h2>Ready to enter, expand or scale in the U.S. market?</h2>
    <p>Tell us where you are today. We'll tell you honestly whether and how we can help.</p>
    <a class="btn" href={u("/contact/")}>Start a conversation <span>→</span></a>
  </div>
</section>
