---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import { assess, method, industries, leaders, u } from '../data/content';
---
<Base>
  <Hero cta tagline eyebrow="U.S. market entry & growth" title="Strategy. Access. Execution." lead="Helping international companies enter and expand in the United States, and helping U.S. companies accelerate growth, build strategic partnerships and strengthen operations." />

  <section class="section">
    <div class="wrap split wide-left">
      <div class="reveal">
        <div class="eyebrow">What we do</div>
        <h2>Before you invest in U.S. expansion, know where you are going.</h2>
        <p class="lead">Entering the U.S. market can require significant investment long before the first commercial opportunity is created. USARunway evaluates the opportunity first, helping companies determine where to focus their time, capital and resources before committing to expansion.</p>
        <p class="rule-quote" style="margin-top:2rem">Designed to reduce unnecessary expansion spend and create a more focused path to opportunity.</p>
      </div>
      <ol class="steps reveal">
        {assess.map((s, i) => <li><span class="n">0{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">The USARunway method</div>
        <h2>From understanding the opportunity to executing the U.S. pathway.</h2>
      </div>
      <ol class="method reveal">
        {method.map((m, i) => <li><div class="dot">0{i + 1}</div><h3>{m.t}</h3><p>{m.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="dark statement">
    <div class="wrap reveal">
      <h2>We move forward only when we believe we can create meaningful value.</h2>
      <p>Our process begins with internal due diligence. If we do not believe our expertise, capabilities and network can meaningfully support the opportunity, we say so.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Industries</div>
        <h2>Where experience meets opportunity.</h2>
        <p class="lead">Sector-specific expertise for navigating complex U.S. markets.</p>
      </div>
      <div class="grid g3">
        {industries.map(i => (
          <a class="card link reveal" href={u(`/industries/#${i.id}`)}>
            <h3>{i.name}</h3><p>{i.lead}</p><span class="more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap split wide-left" style="align-items:center">
      <div class="ph reveal" style="aspect-ratio:16/10"><span>Team photo placeholder<br />(new photo to be provided)</span></div>
      <div class="reveal">
        <div class="eyebrow">Leadership</div>
        <h2>Experience behind the strategy.</h2>
        <p class="lead" style="font-size:1.05em">USARunway brings together senior executive, operational and sector expertise across healthcare, defense, aerospace, cybersecurity, supply chain and advanced technology. Senior expertise. One integrated U.S. team.</p>
        <a class="btn ghost" href={u("/leadership/")}>Meet our team <span>→</span></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
