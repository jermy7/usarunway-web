---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Slide from '../components/Slide.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { assess, partnership, icons } from '../data/content';
---
<Base title="What we do">
  <Hero short img="hero-austin" pos="center 55%" eyebrow="What we do" title="Strategy. Access. Execution." lead="Helping international companies enter and expand in the United States, and helping U.S. companies accelerate growth." />

  <Slide img="boardroom-full" pos="right center" side="left">
    <div class="copy reveal">
      <div class="eyebrow">Evaluate first. Commit second.</div>
      <h2>Before you invest in U.S. expansion, know where you are going.</h2>
      <p class="lead">Entering the U.S. market can require significant investment long before the first commercial opportunity is created. USARunway evaluates the opportunity first, helping companies determine where to focus their time, capital and resources before committing to expansion.</p>
      <ol class="olist">
        {assess.map((s, i) => <li><span class="n">0{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}
      </ol>
      <p class="callout">Designed to reduce unnecessary expansion spend and create a more focused path to opportunity.</p>
    </div>
  </Slide>

  <Slide img="event-dinner" pos="center" side="right">
    <div class="copy glass panel-r reveal">
      <div class="eyebrow">A partnership built for execution</div>
      <h2>Real relationships. Real opportunities. Meaningful execution.</h2>
      <p>We work as an extension of our clients' teams, combining strategic guidance, U.S.-based representation and trusted relationships to move opportunities forward.</p>
      <div style="margin-top:1rem">
        {partnership.map((p, i) => <div class="gi"><Icon name={icons.partnership[i]} size={30} /><div><h4>{p.t}</h4><p>{p.d}</p></div></div>)}
      </div>
    </div>
  </Slide>

  <Slide img="lunch" side="center" min="mid">
    <div class="copy reveal">
      <h2>Your U.S. team before you build your U.S. team.</h2>
      <p class="lead">Strategy. Access. Execution.</p>
    </div>
  </Slide>
  <CtaBand />
</Base>
