---
import { u } from '../data/content';
// Slide whose background is a muted looping video; content sits on top (like Slide.astro).
const { src, poster, side = 'left' } = Astro.props;
---
<section class:list={['slide', 'vslide', `side-${side}`, 'tone-dark', 'min-tall']}>
  <video class="vbg" muted loop playsinline preload="none" poster={u(`/video/${poster}.jpg`)} data-src={u(`/video/${src}.mp4`)} aria-hidden="true"></video>
  <div class="slide-shade" aria-hidden="true"></div>
  <div class="wrap slide-inner">
    <slot />
    <button class="sound-btn" type="button" aria-pressed="false" data-sound>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path class="on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="off" d="m16 9 5 6m0-6-5 6"/></svg>
      <span class="lbl">Watch with sound</span>
    </button>
  </div>
</section>
