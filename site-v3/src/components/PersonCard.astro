---
import { u, photo } from '../data/content';
const { name, role, bio, tags = [] } = Astro.props;
const file = photo[name];
const alt = name.replace(/,.*/, '');
---
<article class="person reveal">
  <div class="avatar photo">
    {file && <img src={u(`/img/${file}.jpg`)} alt={`Portrait of ${alt}`} loading="lazy" width="640" height="640" />}
  </div>
  <h3>{name}</h3>
  <div class="role">{role}</div>
  {tags.length > 0 && <div class="tags">{tags.map((t: string) => <span>{t}</span>)}</div>}
  <details><summary>Biography</summary><p>{bio}</p></details>
</article>
