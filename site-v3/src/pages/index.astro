---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { assess, method, industries, leaders, icons, stats, indImg, photo, u } from '../data/content';
const img = (n: string) => u(`/img/${n}.jpg`);
---
<Base>
  <Hero cta tagline eyebrow="U.S. market entry & growth" title="Strategy. Access. <em>Execution.</em>" lead="Helping international companies enter and expand in the United States, and helping U.S. companies accelerate growth, build strategic partnerships and strengthen operations." />

  <section class="stats" id="intro">
    <div class="wrap grid g4">
      {stats.map(s => (
        <div class="stat reveal"><div class="num"><span data-to={s.n}>0</span></div><div class="lbl">{s.label}</div><div class="sub">{s.sub}</div></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap split" style="align-items:center">
      <div class="frame reveal"><img src={img('boardroom')} alt="Advisors reviewing documents around a boardroom table" loading="lazy" width="1920" height="1080" /></div>
      <div class="reveal">
        <div class="eyebrow">What we do</div>
        <h2>Before you invest in U.S. expansion, know where you are going.</h2>
        <p class="lead" style="font-size:1.08em">Entering the U.S. market can require significant investment long before the first commercial opportunity is created. USARunway evaluates the opportunity first.</p>
        <ol class="steps">
          {assess.map((s, i) => <li><span class="n">0{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}
        </ol>
      </div>
    </div>
    <div class="wrap"><p class="rule-quote center-q reveal">Designed to reduce unnecessary expansion spend and create a more focused path to opportunity.</p></div>
  </section>

  <section class="section method-sec">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">The USARunway method</div>
        <h2>From understanding the opportunity to executing the U.S. pathway.</h2>
      </div>
      <div class="mtabs reveal" style={`--bg:url(${img('capitol')})`}>
        <div class="mlist" role="tablist" aria-orientation="vertical">
          {method.map((m, i) => (
            <button role="tab" id={`t${i}`} aria-controls={`p${i}`}><span class="mnum">0{i + 1}</span><Icon name={icons.method[i]} size={22} /><span>{m.t}</span></button>
          ))}
        </div>
        <div class="mpanels photo-panels">
          {method.map((m, i) => (
            <div role="tabpanel" id={`p${i}`} aria-labelledby={`t${i}`}>
              <div class="mtext wide"><span class="step-no">Step 0{i + 1} / 05</span><h3>{m.t}</h3><p>{m.d}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="dark statement qualify photo-band" style={`--bg:url(${img('meeting-room')})`}>
    <div class="wrap reveal">
      <div class="eyebrow" style="justify-content:center">Our promise</div>
      <h2>We move forward only when we believe we can create meaningful value.</h2>
      <p>Our process begins with internal due diligence. If we do not believe our expertise, capabilities and network can meaningfully support the opportunity, we say so.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Industries</div>
        <h2>Where experience meets opportunity.</h2>
        <p class="lead">Sector-specific expertise for navigating complex U.S. markets.</p>
      </div>
      <div class="grid g3 ind-grid">
        {industries.map((i, k) => (
          <a class="ind-card photo reveal" href={u(`/industries/#${i.id}`)}>
            <img src={img(indImg[k])} alt="" loading="lazy" width="800" height="552" />
            <div class="ind-body">
              <div class="ico"><Icon name={icons.industries[k]} size={26} /></div>
              <h3>{i.name}</h3><p>{i.lead}</p>
              <span class="more">Explore <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="eyebrow">Real relationships</div>
        <h2>Real relationships. Real opportunities. Meaningful execution.</h2>
      </div>
      <div class="gallery reveal">
        <figure class="g-a"><img src={img('event-panel')} alt="Panel discussion at a business event" loading="lazy" width="1600" height="900" /></figure>
        <figure class="g-b"><img src={img('event-dinner')} alt="Executive dinner in a private library room" loading="lazy" width="1400" height="1050" /></figure>
        <figure class="g-c"><img src={img('event-roundtable')} alt="Executives in conversation at a luncheon" loading="lazy" width="1400" height="900" /></figure>
        <figure class="g-d"><img src={img('event-talk')} alt="Recognition ceremony at a business event" loading="lazy" width="1400" height="1050" /></figure>
      </div>
    </div>
  </section>
  <section class="section cgi">
    <div class="wrap split" style="align-items:center">
      <div class="reveal">
        <div class="eyebrow">Commitment to action</div>
        <h2>Relationships that reach the global stage.</h2>
        <p class="lead" style="font-size:1.05em">USARunway's leadership brings long-standing networks across healthcare, business, government and the Texas innovation ecosystem, from boardrooms to international forums such as the Clinton Global Initiative.</p>
        <a class="btn ghost" href={u('/leadership/')}>Meet our team <span>→</span></a>
      </div>
      <figure class="frame cgi-photo reveal"><img src={img('event-cgi')} alt="Clinton Global Initiative Commitment to Action certificate presentation with former U.S. President Bill Clinton" loading="lazy" width="1000" height="666" /><figcaption>Clinton Global Initiative · Commitment to Action</figcaption></figure>
    </div>
  </section>


  <section class="section">
    <div class="wrap split wide-left" style="align-items:center">
      <div class="portraits reveal">
        {leaders.map(p => <figure><img src={img(photo[p.name])} alt={`Portrait of ${p.name.replace(/,.*/, '')}`} loading="lazy" width="640" height="640" /><figcaption>{p.name.replace(/,.*/, '')}<small>{p.role}</small></figcaption></figure>)}
      </div>
      <div class="reveal">
        <div class="eyebrow">Leadership</div>
        <h2>Experience behind the strategy.</h2>
        <p class="lead" style="font-size:1.05em">USARunway brings together senior executive, operational and sector expertise across healthcare, defense, aerospace, cybersecurity, supply chain and advanced technology. Senior expertise. One integrated U.S. team.</p>
        <a class="btn" href={u("/leadership/")}>Meet our team <span>→</span></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
